{
  "name": "@tessera/search",
  "version": "0.1.2",
  "private": true,
  "description": "Tessera search, command palette, backlinks and graph view.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./i18n": "./src/i18n/index.ts",
    "./i18n/registration": "./src/i18n/registration.ts",
    "./services": "./src/services/index.ts",
    "./palette-host": "./src/palette/index.ts",
    "./search-page": "./src/search-page/search-page.tsx",
    "./test-hooks": "./src/dev/test-hooks.ts",
    "./backlinks": "./src/backlinks/index.tsx",
    "./graph": "./src/graph/index.tsx"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "bench": "tsx src/bench/search.bench.ts"
  },
  "dependencies": {
    "@tessera/core": "workspace:*",
    "@tessera/ui": "workspace:*",
    "graphology": "0.26.0",
    "graphology-layout": "0.6.1",
    "graphology-layout-forceatlas2": "0.10.1",
    "graphology-types": "0.24.8",
    "lucide-react": "1.48.0",
    "minisearch": "7.2.0",
    "sigma": "3.0.3",
    "yjs": "13.6.33"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
