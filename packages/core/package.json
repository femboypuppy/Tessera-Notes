  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "fractional-indexing": "4.0.0",
    "nanoid": "6.0.1",
    "prosemirror-model": "1.25.12",
