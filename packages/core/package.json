{
  "name": "@tessera/core",
  "version": "0.1.2",
  "private": true,
  "description": "Tessera contracts: data model, canonical document schema, interfaces, extension points and in-memory stubs.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react/index.ts",
