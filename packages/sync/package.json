{
  "name": "@tessera/sync",
  "version": "0.1.2",
  "private": true,
  "description": "Tessera storage and sync: IndexedDB persistence, multi-tab sync, the Hocuspocus client, presence and version history.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./stores": "./src/stores/index.ts",
    "./provider": "./src/provider/index.ts",
    "./socket": "./src/provider/socket.ts",
    "./client": "./src/client/index.ts",
    "./activate": "./src/feature/activate.ts",
    "./ui": "./src/ui/entry.tsx",
    "./i18n": "./src/i18n/registration.ts"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@hocuspocus/provider": "4.7.0",
    "@tessera/core": "workspace:*",
    "@tessera/ui": "workspace:*",
    "lucide-react": "1.48.0",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "fake-indexeddb": "6.2.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
