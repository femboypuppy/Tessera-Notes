{
  "name": "@tessera/db-views",
  "version": "0.1.2",
  "private": true,
  "description": "Tessera databases: the query engine and the table, board, calendar, gallery and list views.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./query": "./src/query/index.ts",
    "./csv": "./src/csv/csv.ts",
    "./operations": "./src/model/operations.ts",
    "./database-body": "./src/entries/database-body.tsx",
    "./row-properties": "./src/entries/row-properties.tsx",
    "./linked-from": "./src/entries/linked-from.tsx",
    "./inline-database": "./src/entries/inline-database.tsx",
    "./actions": "./src/entries/actions.ts"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test:coverage": "vitest run src/query --exclude \"**/perf.test.ts\" --coverage.enabled --coverage.provider=v8 --coverage.include=\"src/query/**\" --coverage.exclude=\"**/*.test.ts\" --coverage.reporter=text --coverage.thresholds.lines=95 --coverage.thresholds.statements=95 --coverage.thresholds.functions=95 --coverage.thresholds.branches=95"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@tanstack/react-virtual": "3.14.13",
    "@tessera/core": "workspace:*",
    "@tessera/ui": "workspace:*",
    "lucide-react": "1.47.0",
    "papaparse": "5.7.0",
    "yjs": "13.6.32",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/papaparse": "5.5.2",
    "fast-check": "4.10.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
