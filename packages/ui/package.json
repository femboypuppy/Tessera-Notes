{
  "name": "@tessera/ui",
  "version": "0.1.1",
  "private": true,
  "description": "Tessera design system: CSS-variable design tokens, Radix-based components and the t() i18n helper.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./i18n": "./src/i18n/i18n.ts",
    "./styles.css": "./src/styles/index.css"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "emojibase": "17.0.0",
    "emojibase-data": "17.0.0",
    "lucide-react": "1.47.0",
    "radix-ui": "1.6.7",
    "tailwind-merge": "3.7.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tessera/core": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
