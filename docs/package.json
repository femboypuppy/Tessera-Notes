{
  "name": "@tessera/docs",
  "version": "0.1.2",
  "private": true,
  "description": "The Tessera documentation site (VitePress) and the brand asset renderer.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vitepress dev",
    "build": "pnpm run test && vitepress build",
    "preview": "vitepress preview",
    "test": "node --test \"scripts/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "brand": "node scripts/render-brand.ts",
    "screenshots": "vitepress build && node scripts/screenshot-docs.ts"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@types/fontkit": "2.0.9",
    "@types/node": "24.13.6",
    "fontkit": "2.0.4",
    "mermaid": "11.17.2",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "vitepress": "1.6.4",
    "vitepress-plugin-mermaid": "2.0.17",
    "vue": "3.5.43",
    "yaml": "2.9.1"
  }
}
