{
  "name": "@tessera/server",
  "version": "0.1.2",
  "private": true,
  "description": "The Tessera sync and API server (Hocuspocus, SQLite, Hono).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "tessera-server": "./dist/main.js"
  },
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "build": "tsdown",
    "start": "tsdown --log-level warn && node dist/main.js",
    "load-test": "tsx scripts/load-test.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@hocuspocus/server": "4.7.0",
    "@hono/node-server": "2.1.1",
    "@tessera/core": "workspace:*",
    "argon2": "0.45.1",
    "better-sqlite3": "13.0.3",
    "hono": "4.13.8",
    "nanoid": "6.0.1",
    "pino": "10.3.1",
    "ws": "8.21.3",
    "y-protocols": "1.0.7",
    "yjs": "13.6.32",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@hocuspocus/provider": "4.7.0",
    "@tessera/sync": "workspace:*",
    "@types/better-sqlite3": "9.6.0",
    "@types/ws": "8.18.1",
    "fake-indexeddb": "6.2.5",
    "lib0": "0.2.117",
    "pino-pretty": "13.1.3"
  }
}
