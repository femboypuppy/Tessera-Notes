{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: the whole app.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "allow-app-info",
    "allow-app-quit",
    "allow-flush-done",
    "allow-open-external",
    "allow-links-take",
    "allow-menu-set",
    "allow-window-set-title",
    "allow-window-zoom",
    "allow-window-toggle-fullscreen",
    "allow-window-show-main",
    "allow-prefs-get",
    "allow-prefs-set",
    "allow-updates-mark-checked",
    "allow-capture-show",
    "allow-capture-hide",
    "allow-registry-list",
    "allow-registry-upsert",
    "allow-registry-remove",
    "allow-registry-touch",
    "allow-folder-inspect",
    "allow-folder-suggest",
    "allow-folder-pick",
    "allow-folder-reveal",
    "allow-file-save",
    "allow-window-print",
    "allow-workspace-attach",
    "allow-workspace-detach",
    "allow-workspace-status",
    "allow-workspace-set-name",
    "allow-workspace-merge-conflict",
    "allow-doc-load",
    "allow-doc-store",
    "allow-doc-compact",
    "allow-doc-delete",
    "allow-doc-list",
    "allow-asset-put",
    "allow-asset-get",
    "allow-asset-info",
    "allow-asset-list",
    "allow-asset-delete",
    "allow-mirror-begin",
    "allow-mirror-write",
    "allow-mirror-finish",
    "allow-secret-get",
    "allow-secret-set",
    "allow-secret-delete",
    "allow-secret-servers",
    "allow-updater-check",
    "allow-updater-install"
  ]
}
