{
  "name": "@tessera/desktop",
  "version": "0.1.2",
  "private": true,
  "description": "The Tessera desktop app (Tauri 2). Its TypeScript side exports the desktop services and UI that the web desktop feature registers.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/fake-tauri.ts"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "tauri": "tauri",
    "dev:app": "tauri dev",
    "build:app": "tauri build",
    "icons": "tauri icon src-tauri/icons/source.svg && node scripts/prune-mobile-icons.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "build:linux-docker": "node scripts/build-linux-in-docker.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tessera/core": "workspace:*",
    "@tessera/ui": "workspace:*",
    "lucide-react": "1.48.0",
    "yjs": "13.6.33",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.5",
    "@tessera/importers": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
